# Payload
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Postgres (local docker / Neon / Vercel Postgres)
# Local: postgresql://postgres:postgres@127.0.0.1:5433/nesta
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5433/nesta

# Vercel Blob (production uploads). Leave empty for local disk storage.
BLOB_READ_WRITE_TOKEN=

# Public site URL (SEO / canonical / live preview)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
